{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 0-8,22-23 * * 1-5",
    "* * * * 0,6"
  ],
  "packageRules": [
    {
      "description": "Wait 7 days before normal version updates to reduce supply-chain risk.",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Automerge patch updates after checks pass.",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
